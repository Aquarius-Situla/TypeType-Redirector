#!name=Bilibili & YouTube to TypeType
#!desc=将 Bilibili(b23.tv) 与 YouTube(youtu.be) 视频链接自动 302 重定向到 TypeType
#!author=TypeType
#!system=ios
#!arguments=domain:www.example.com
#!arguments-desc=domain: 你的 TypeType 域名（不含协议头，如 www.example.com）

[MITM]
hostname = %APPEND% www.bilibili.com, m.bilibili.com, b23.tv, www.youtube.com, m.youtube.com, youtu.be

[URL Rewrite]
# Bilibili 网页端
^https?:\/\/(?:www\.|m\.)?bilibili\.com\/video\/(BV[0-9a-zA-Z]+) https://{{{domain}}}/watch?v=$1 302
# Bilibili b23.tv 短链 (将完整短链传给 /watch?v=)
^https?:\/\/b23\.tv\/(.*) https://{{{domain}}}/watch?v=https://b23.tv/$1 302
# YouTube 视频
^https?:\/\/(?:www\.|m\.)?youtube\.com\/watch\?.*v=([a-zA-Z0-9_-]+) https://{{{domain}}}/watch?v=$1 302
# YouTube Shorts
^https?:\/\/(?:www\.|m\.)?youtube\.com\/shorts\/([a-zA-Z0-9_-]+) https://{{{domain}}}/watch?v=$1 302
# youtu.be 短链
^https?:\/\/youtu\.be\/([a-zA-Z0-9_-]+) https://{{{domain}}}/watch?v=$1 302
