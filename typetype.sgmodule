#!name=Bilibili & YouTube to TypeType
#!desc=将 Bilibili(b23.tv) 与 YouTube(youtu.be) 视频链接及主页自动 302 重定向到 TypeType
#!author=TypeType
#!system=ios
#!arguments=domain:www.example.com
#!arguments-desc=domain: 你的 TypeType 域名（不含协议头，如 www.example.com）

[MITM]
hostname = %APPEND% www.bilibili.com, m.bilibili.com, b23.tv, www.youtube.com, m.youtube.com, youtu.be

[URL Rewrite]
# 1. Bilibili 网页版与移动端 (精准捕获 12 位 BV 号)
^https?://.*bilibili\.com/video/(BV[0-9a-zA-Z]{10}).*$ https://{{{domain}}}/watch?v=$1 302

# 2. Bilibili b23.tv 短链 (区分 BV 短链与普通短链)
^https?://b23\.tv/(BV[0-9a-zA-Z]{10}).*$ https://{{{domain}}}/watch?v=$1 302
^https?://b23\.tv/([a-zA-Z0-9]+).*$ https://{{{domain}}}/watch?v=https://b23.tv/$1 302

# 3. YouTube 视频 (v 为第一个参数)
^https?://.*youtube\.com/watch\?v=([a-zA-Z0-9_-]{11}).*$ https://{{{domain}}}/watch?v=$1 302

# 4. YouTube 视频 (v 在后续参数中)
^https?://.*youtube\.com/watch\?.*&v=([a-zA-Z0-9_-]{11}).*$ https://{{{domain}}}/watch?v=$1 302

# 5. YouTube Shorts
^https?://.*youtube\.com/shorts/([a-zA-Z0-9_-]{11}).*$ https://{{{domain}}}/watch?v=$1 302

# 6. youtu.be 短链
^https?://youtu\.be/([a-zA-Z0-9_-]{11}).*$ https://{{{domain}}}/watch?v=$1 302

# 7. 主页重定向 (防沉迷/去信息流干扰，直接进入 TypeType 首页)
^https?://.*bilibili\.com/?([?#].*)?$ https://{{{domain}}}/ 302
^https?://b23\.tv/?([?#].*)?$ https://{{{domain}}}/ 302
^https?://.*youtube\.com/?([?#].*)?$ https://{{{domain}}}/ 302
^https?://youtu\.be/?([?#].*)?$ https://{{{domain}}}/ 302
