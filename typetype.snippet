# TypeType 重定向重写分片 (Quantumult X)
# 作用：将 B站与 YouTube 视频链接 302 跳转到 TypeType

hostname = www.bilibili.com, m.bilibili.com, b23.tv, www.youtube.com, m.youtube.com, youtu.be

# 1. Bilibili 网页版 (精准匹配 12 位 BV 号，自动剔除尾随斜杠 / 与追踪参数)
^https?:\/\/(?:www\.|m\.)?bilibili\.com\/video\/(BV[0-9a-zA-Z]{10})(?:[/?#].*)?$ url 302 https://www.example.com/watch?v=$1

# 2. Bilibili b23.tv 短链 (如果是 BV 号短链直接提取 BV，否则传纯净短链)
^https?:\/\/b23\.tv\/(BV[0-9a-zA-Z]{10})(?:[/?#].*)?$ url 302 https://www.example.com/watch?v=$1
^https?:\/\/b23\.tv\/([a-zA-Z0-9]+)(?:[/?#].*)?$ url 302 https://www.example.com/watch?v=https://b23.tv/$1

# 3. YouTube 视频 (精准匹配 11 位视频 ID，清洗多余参数)
^https?:\/\/(?:www\.|m\.)?youtube\.com\/watch\?(?:.*&)?v=([a-zA-Z0-9_-]{11})(?:[&#].*)?$ url 302 https://www.example.com/watch?v=$1

# 4. YouTube Shorts (清洗尾随斜杠与参数)
^https?:\/\/(?:www\.|m\.)?youtube\.com\/shorts\/([a-zA-Z0-9_-]{11})(?:[/?#].*)?$ url 302 https://www.example.com/watch?v=$1

# 5. youtu.be 短链 (清洗尾随斜杠与参数)
^https?:\/\/youtu\.be\/([a-zA-Z0-9_-]{11})(?:[/?#].*)?$ url 302 https://www.example.com/watch?v=$1
